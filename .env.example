DATABASE_URL=postgres://fichub:***@localhost:5432/fichub
REDIS_URL=redis://localhost:6379
CACHE_DIR=./cache
SECONDARY_CACHE_DIR=
EXPORT_VERSION=1
DYNAMIC_RATE_LIMIT=true
NODE_NAME=orion
CALIBRE_CONTAINER=
PORT=3000
FRONTEND_DIR=./frontend/build
TMP_DIR=./tmp
# Optional: path to a MaxMind GeoLite2-ASN .mmdb file. When set, the rate
# limiter blocks requests from datacenter/hosting ASNs (1h retry-after).
# Unset or unreadable = datacenter blocking disabled (fail-open).
MAXMIND_DB=
RUST_LOG=info,fichub=debug

# ── Translate-everything (docs/plans/translation-everything.md §6) ──
# Master switch for the translation API + worker.
TRANSLATION_ENABLED=true
# LLM machine-translation tier (needs Ollama). Disable for human-only mode.
TRANSLATE_LLM_ENABLED=true
# Model used for translation; defaults to OLLAMA_CHAT_MODEL.
#TRANSLATE_MODEL=lfm2.5:8b
# Max characters per translated chunk (paragraph-aligned).
TRANSLATE_CHUNK_CHARS=4000
# Hourly machine-translation budgets: site-wide and per logged-in user.
TRANSLATE_GLOBAL_BUDGET_PER_HOUR=1000
TRANSLATE_USER_BUDGET_PER_HOUR=50
# Target locales offered by the reading-language picker.
TRANSLATE_LOCALES=de,es,fr,pt-BR,zh
# Show the "machine translated" badge on LLM output (recommended: true).
TRANSLATE_BADGE_MACHINE=false
# Skip curator review and auto-approve machine output ("LLM translates,
# nobody votes" mode for tiny instances; badge should stay on).
TRANSLATE_AUTO_APPROVE_MACHINE=false
# Prompt once to set reading locale on first visit with a non-UI language.
TRANSLATE_READING_LOCALE_ASK=true
# SPA dictionary override from DB (approved ui_translations beat static TS dicts).
TRANSLATE_UI_STRINGS=true
# Keep machine rows visible even after dismissal (shows "dismissed" badge).
TRANSLATE_KEEP_MACHINE_ON_DISMISS=false

# Curator quorum per proposal kind (distinct approve/dismiss votes needed).
PROPOSAL_QUORUM_TRANSLATE=2
PROPOSAL_QUORUM_CONTENT_FIX=2
PROPOSAL_QUORUM_POST_EDIT=1
PROPOSAL_QUORUM_DOC_EDIT=1
PROPOSAL_QUORUM_WORK_DELETION=2
# Daily proposal cap per user.
PROPOSALS_PER_USER_PER_DAY=10

# Translation points (M6) — awarded via reputation_events for curator actions.
# Awarded points: approved = submitter gets APPROVED, reviewers get REVIEWED.
TRANSLATE_POINTS_APPROVED=15
TRANSLATE_POINTS_IMPROVED=25
TRANSLATE_POINTS_REVIEWED=2
TRANSLATE_POINTS_FLAG=1
TRANSLATE_POINTS_DAILY_CAP=100

# Public origin used to build absolute URLs in sitemaps (SEO).
# Falls back to OPDS_BASE_URL when unset, then http://localhost:8000.
PUBLIC_BASE_URL=https://fichub.example.com
