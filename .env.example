# ficnexus exporter — environment
#
# ficnexus scrapes a story URL and builds a downloadable file. There are no
# accounts, no forum, no recommender: the only state it keeps is the cache of
# fetched works and built exports. See docs/EXPORTER-SCOPE.md.

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://fichub:password@localhost:5432/fichub
REDIS_URL=redis://localhost:6379

# ── Where files go ──────────────────────────────────────────────────────────
CACHE_DIR=./cache                                 # built files (epub/html/txt/…), hash-keyed
BODY_CACHE_DIR=/public/literature/fichub/bodies   # scraped bodies, so repeat exports skip the network
META_DIR=/public/literature/fichub/meta           # meta snapshots (defaults to <BODY_CACHE_DIR>/../meta)
TMP_DIR=./tmp                                     # scratch space for epub-builder and Calibre

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_NAME=orion
EXPORT_VERSION=1                                  # bump to invalidate every cached export
RUST_LOG=info,fichub=debug

# ── Conversion ──────────────────────────────────────────────────────────────
# Docker container with ebook-convert (Calibre). Empty = MOBI/PDF/AZW3/KEPUB/
# DOCX conversions are unavailable and /api/epub/convert says so clearly;
# EPUB, HTML, TXT and Markdown are pure Rust and always work.
CALIBRE_CONTAINER=

# ── Anti-bot / rate limiting ────────────────────────────────────────────────
DYNAMIC_RATE_LIMIT=true
# Optional MaxMind GeoLite2-ASN .mmdb. Unset = datacenter blocking disabled.
MAXMIND_DB=
# CIDR list of proxies whose X-Forwarded-For is trusted.
TRUSTED_PROXIES=
# Optional file of datacenter IP tags: "<cidr>,<asn>,<label>" per line.
IP_TAG_SOURCES=
# Proof-of-work gate for shadowbanned clients.
POW_DIFFICULTY=20
POW_TTL_SECS=600

# ── Scrape fallbacks ────────────────────────────────────────────────────────
# Internet Archive snapshots when the live site blocks or 404s the fetch.
WAYBACK_FALLBACK_ENABLED=false
WAYBACK_MAX_SNAPSHOT_AGE_DAYS=365
WAYBACK_CDX_RATE_LIMIT_PER_SEC=1

# ── Optional: author-link resolution in /api/meta ───────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
